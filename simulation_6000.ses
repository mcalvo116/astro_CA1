{load_file("nrngui.hoc")}
objectvar save_window_, rvp_
objectvar scene_vector_[4]
objectvar ocbox_, ocbox_list_, scene_, scene_list_
{ocbox_list_ = new List()  scene_list_ = new List()}
{pwman_place(0,0,0)}
{
save_window_ = new Graph(0)
save_window_.size(0,6000,-80,40)
scene_vector_[2] = save_window_
{save_window_.view(0, -80, 6000, 120, 655, 261, 300.6, 200.8)}
graphList[0].append(save_window_)
save_window_.save_name("graphList[0].")
save_window_.addexpr("v(.5)", 1, 1, 0.8, 0.9, 2)
}
{
save_window_ = new Graph(0)
save_window_.size(0,1200,0,0.001)

{save_window_.view(0, 0, 6000, 0.001, 655, 500, 300.6, 200.8)}

graphList[0].append(save_window_)
save_window_.save_name("graphList[0].")

save_window_.addexpr("cai(.5)", 1, 1, 0.2, 0.2, 2)
}
